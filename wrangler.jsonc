{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dev",
	"main": "src/index.js",
	"compatibility_date": "2026-04-22",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "REDIRS",
			"id": "78696364918a4aefa0ec8027f1ec662c",
			"remote": true
		}
	]
}